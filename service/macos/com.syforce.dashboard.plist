<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd LaunchAgent. Replace __APP__ with the absolute path of the kit's app/ folder, then:
     cp com.syforce.dashboard.plist ~/Library/LaunchAgents/
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.syforce.dashboard.plist
     (stop: launchctl bootout gui/$(id -u)/com.syforce.dashboard) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.syforce.dashboard</string>
  <key>ProgramArguments</key><array>
    <string>__APP__/venv/bin/python</string>
    <string>-u</string>
    <string>__APP__/server.py</string>
    <string>--port</string><string>9001</string>
  </array>
  <key>WorkingDirectory</key><string>__APP__</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>/tmp/syforce.log</string>
  <key>StandardErrorPath</key><string>/tmp/syforce.err.log</string>
</dict></plist>
